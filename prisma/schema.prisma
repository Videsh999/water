generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Zone {
  id        String    @id @default(cuid())
  name      String
  city      String    @default("Hyderabad")
  users     User[]
  addresses Address[]
  createdAt DateTime  @default(now())
}

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  name       String
  phone      String?
  /// CUSTOMER | DRIVER | ADMIN
  role       String
  password   String
  zoneId     String?
  zone       Zone?    @relation(fields: [zoneId], references: [id])
  addresses  Address[]
  orders     Order[]  @relation("CustomerOrders")
  deliveries Order[]  @relation("DriverDeliveries")
  createdAt  DateTime @default(now())
}

model Product {
  id           String      @id @default(cuid())
  name         String
  description  String
  priceInPaise Int
  unit         String
  emoji        String      @default("💧")
  active       Boolean     @default(true)
  sortOrder    Int         @default(0)
  orderItems   OrderItem[]
  createdAt    DateTime    @default(now())
}

model Address {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id])
  label    String  @default("Home")
  line1    String
  line2    String?
  landmark String?
  zoneId   String
  zone     Zone    @relation(fields: [zoneId], references: [id])
  pincode  String
  city     String  @default("Hyderabad")
  orders   Order[]
}

model Order {
  id            String     @id @default(cuid())
  customerId    String
  customer      User       @relation("CustomerOrders", fields: [customerId], references: [id])
  driverId      String?
  driver        User?      @relation("DriverDeliveries", fields: [driverId], references: [id])
  addressId     String
  address       Address    @relation(fields: [addressId], references: [id])
  /// PENDING | ASSIGNED | OUT_FOR_DELIVERY | DELIVERED | CANCELLED
  status        String     @default("PENDING")
  /// ONE_TIME | SUBSCRIPTION
  type          String     @default("ONE_TIME")
  /// PENDING | STUB_PAID
  paymentStatus String     @default("STUB_PAID")
  paymentNote   String     @default("Payment stub — Razorpay/UPI coming soon")
  notes         String?
  totalInPaise  Int
  items         OrderItem[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deliveredAt   DateTime?
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product @relation(fields: [productId], references: [id])
  quantity     Int
  priceInPaise Int
}
